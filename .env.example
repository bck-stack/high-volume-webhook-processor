# HMAC-SHA256 secret shared with the sender (required — unsigned webhooks are rejected)
WEBHOOK_SECRET=change_me_to_a_long_random_string
# Set true ONLY for local testing without signatures
ALLOW_UNSIGNED=false

# API key for GET /logs and GET /metrics (send as X-API-Key header). Empty = endpoints disabled.
LOGS_API_KEY=change_me_too

# Supabase connection (optional — falls back to in-memory ring buffer)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here
SUPABASE_TABLE=webhook_logs

# Tuning
MAX_LOGS_RESPONSE=50
MAX_MEMORY_LOGS=500
MAX_BODY_BYTES=1048576
QUEUE_SIZE=10000
BATCH_SIZE=100
BATCH_INTERVAL=0.5
DEDUP_WINDOW=10000
LOG_LEVEL=INFO
